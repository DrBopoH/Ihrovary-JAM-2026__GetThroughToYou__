; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Resource",
"class": "CharacterData",
"language": "GDScript",
"path": "res://source/blueprints/CharacterData.gd"
}, {
"base": "Resource",
"class": "DialogueStep",
"language": "GDScript",
"path": "res://source/blueprints/DialogueStep.gd"
}, {
"base": "Resource",
"class": "DialogueStyles",
"language": "GDScript",
"path": "res://source/blueprints/DialogueStyles.gd"
} ]
_global_script_class_icons={
"CharacterData": "",
"DialogueStep": "",
"DialogueStyles": ""
}

[application]

config/name="Get Through To You"
run/main_scene="res://source/bootstrap/main.tscn"

[display]

